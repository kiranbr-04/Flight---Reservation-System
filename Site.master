<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.master.cs" Inherits="Site" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8" />
    <title>Travel Booking System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="css/style.css" rel="stylesheet" />
    <asp:ContentPlaceHolder id="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg navbar-light fixed-top">
            <div class="container">
                <a class="navbar-brand" href="Home.aspx">TravelBook</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" href="Home.aspx">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="Search.aspx">Search</a></li>
                        <% if (Session["UserID"] == null) { %>
                            <li class="nav-item"><a class="nav-link" href="Login.aspx">Login</a></li>
                            <li class="nav-item"><a class="nav-link" href="Register.aspx">Register</a></li>
                        <% } else { %>
                            <li class="nav-item"><a class="nav-link" href="MyBookings.aspx">My Bookings</a></li>
                            <li class="nav-item">
                                <asp:LinkButton ID="lnkLogout" runat="server" CssClass="nav-link" OnClick="lnkLogout_Click">Logout</asp:LinkButton>
                            </li>
                        <% } %>
                        <% if (Session["UserID"] == null) { %>
                            <li class="nav-item"><a class="nav-link text-warning fw-bold" href="AdminLogin.aspx">Admin</a></li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container mt-5 pt-5 min-vh-100">
            <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
        </div>
        <% if (Request.Url.AbsolutePath.EndsWith("Home.aspx", StringComparison.OrdinalIgnoreCase) || Request.Url.AbsolutePath.EndsWith("Default.aspx", StringComparison.OrdinalIgnoreCase) || Request.Url.AbsolutePath == "/") { %>
        <footer class="bg-dark text-light text-center py-4 mt-5">
            <div class="container">
                <p class="mb-0 fw-light">&copy; <%: DateTime.Now.Year %> <strong>TravelBook by TicketHub</strong>. All Rights Reserved.</p>
            </div>
        </footer>
        <% } %>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
